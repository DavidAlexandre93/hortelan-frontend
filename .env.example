# Backend
VITE_API_BASE_URL=http://localhost:3001
VITE_API_TIMEOUT_MS=12000

# Demo authentication is always opt-in and must stay false in production.
VITE_ENABLE_DEMO_AUTH=false
VITE_DEMO_EMAIL=demo@hortelan.local
VITE_DEMO_PASSWORD=

# Optional observability
VITE_SENTRY_DSN=
VITE_SENTRY_TRACE_TARGETS=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_SENTRY_REPLAY_SESSION_SAMPLE_RATE=0
VITE_SENTRY_REPLAY_ERROR_SAMPLE_RATE=0
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_METICULOUS=false
