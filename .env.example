# Backend
VITE_API_BASE_URL=http://localhost:3001
VITE_API_TIMEOUT_MS=12000
VITE_ENABLE_LIVE_DATA=false

# Production demo authentication is opt-in and must stay false by default.
# Vite development temporarily provides the fixed local credential in code.
VITE_ENABLE_DEMO_AUTH=false
VITE_DEMO_EMAIL=demo@hortelan.local
VITE_DEMO_PASSWORD=
# Prefer one-way verifiers for an explicitly enabled production-format demo build.
VITE_DEMO_EMAIL_SHA256=
VITE_DEMO_PASSWORD_SHA256=

# Optional observability
VITE_SENTRY_DSN=
VITE_SENTRY_TRACE_TARGETS=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_SENTRY_REPLAY_SESSION_SAMPLE_RATE=0
VITE_SENTRY_REPLAY_ERROR_SAMPLE_RATE=0
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_METICULOUS=false
