{
  "name": "@minimal/material-kit-react",
  "author": "vinyl",
  "licence": "MIT",
  "version": "1.5.0",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "node --no-deprecation ./node_modules/vite/bin/vite.js build",
    "build:release": "npm run build && npm run sentry:sourcemaps",
    "test": "npm run test:unit && npm run test:components",
    "lint": "eslint --max-warnings=0 --ext .js,.jsx ./src",
    "lint:fix": "eslint --fix --ext .js,.jsx ./src",
    "audit:frontend": "node scripts/frontend-audit.mjs",
    "clear-all": "rm -rf build node_modules dist",
    "re-start": "rm -rf build node_modules dist && npm install && npm run dev",
    "re-build": "rm -rf build node_modules dist && npm install && npm run build",
    "sentry:sourcemaps": "node scripts/sentry-sourcemaps.js",
    "build:ssr": "npm run build && vite build --ssr src/entry-server.js --outDir build-ssr",
    "serve:ssr": "node server/ssr-server.mjs",
    "perf:baseline": "node scripts/perf-baseline.mjs",
    "bundle:check": "node scripts/bundle-budget.mjs",
    "security:assets": "node scripts/asset-security.mjs",
    "security:dependencies": "npm audit --omit=dev --audit-level=high",
    "openspec:status": "openspec list",
    "openspec:list": "openspec list --specs",
    "openspec:doctor": "openspec doctor",
    "openspec:validate": "openspec validate --all --strict --no-interactive",
    "openspec:update": "openspec update --force",
    "sdd:check": "npm run openspec:doctor && npm run openspec:validate",
    "format": "prettier --write \"src/**/*.{js,jsx}\" \"server/**/*.mjs\" \"scripts/**/*.mjs\" \"test/**/*.{js,mjs}\" \"*.{js,cjs,mjs,json,md}\" \".github/**/*.{md,yml,yaml}\" \"docs/**/*.md\" \"openspec/**/*.{md,yml,yaml}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx}\" \"server/**/*.mjs\" \"scripts/**/*.mjs\" \"test/**/*.{js,mjs}\" \"*.{js,cjs,mjs,json,md}\" \".github/**/*.{md,yml,yaml}\" \"docs/**/*.md\" \"openspec/**/*.{md,yml,yaml}\"",
    "test:unit": "node scripts/run-node-tests.mjs",
    "test:components": "vitest run",
    "test:coverage": "vitest run --coverage && node scripts/run-node-tests.mjs --coverage",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --grep @a11y",
    "quality:gate": "npm run sdd:check && npm run lint && npm run format:check && npm run test:coverage && npm run build:ssr && npm run security:assets && npm run bundle:check && npm run audit:frontend && npm run security:dependencies && npm run test:e2e"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/public-sans": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@iconify/react": "^6.0.2",
    "@mui/icons-material": "^7.3.11",
    "@mui/material": "^7.3.11",
    "@sentry/react": "^10.69.0",
    "@vercel/analytics": "^2.0.1",
    "change-case": "^4.1.2",
    "date-fns": "^4.4.0",
    "numeral": "^2.0.6",
    "prop-types": "^15.8.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-helmet-async": "^3.0.0",
    "react-hook-form": "^7.85.0",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "simplebar": "^6.3.3",
    "simplebar-react": "^3.3.2",
    "yup": "^1.7.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@alwaysmeticulous/recorder-loader": "^2.323.0",
    "@axe-core/playwright": "^4.13.0",
    "@fission-ai/openspec": "1.11.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "10.0.3",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "prettier": "^3.9.6",
    "terser": "^5.50.0",
    "typescript": "5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "lodash-es": "4.18.1",
    "yaml": "2.9.0"
  },
  "engines": {
    "node": "24.x"
  }
}
